// ===== BASE CONFIGURATION ====================================================
// This is the base configuration for the TypeScript compiler. It declares our
// overall compiler options for the TypeScript compiler
{
  "compilerOptions": {
    // This project is a "very modern" NodeJS project
    "lib": ["esnext"],
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Do not emit any files (we only want to type-check)
    "noEmit": true,

    // ES modules interoperability and preserve import/export statements
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,

    // Import relative files as "file.ts" and rewrite them in the output
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Ultra strict
    "strict": true,
    // Implies:
    // - alwaysStrict
    // - noImplicitAny
    // - noImplicitThis
    // - strictBindCallApply
    // - strictBuiltinIteratorReturn
    // - strictFunctionTypes
    // - strictNullChecks
    // - strictPropertyInitialization
    // - useUnknownInCatchVariables
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
